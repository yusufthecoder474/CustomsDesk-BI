// PREPARED, NOT EXECUTED. Run in Power BI Desktop DAX Query View after loading all 22 measures.
// No report slicers are inherited; contexts are explicit.
EVALUATE
UNION(
    ROW("measure", "Total Shipments", "filter_context", "Unfiltered", "actual_dax_value", [Total Shipments]),
    ROW("measure", "Total Queries", "filter_context", "Unfiltered", "actual_dax_value", [Total Queries]),
    ROW("measure", "Open Backlog", "filter_context", "Unfiltered", "actual_dax_value", [Open Backlog]),
    ROW("measure", "Average Response Hours", "filter_context", "Unfiltered", "actual_dax_value", [Average Response Hours]),
    ROW("measure", "Median Response Hours", "filter_context", "Unfiltered", "actual_dax_value", [Median Response Hours]),
    ROW("measure", "Business Response Days", "filter_context", "Unfiltered", "actual_dax_value", [Business Response Days]),
    ROW("measure", "Responded Queries", "filter_context", "Unfiltered", "actual_dax_value", [Responded Queries]),
    ROW("measure", "SLA Met Responses", "filter_context", "Unfiltered", "actual_dax_value", [SLA Met Responses]),
    ROW("measure", "SLA Compliance %", "filter_context", "Unfiltered", "actual_dax_value", [SLA Compliance %]),
    ROW("measure", "SLA Breaches", "filter_context", "Unfiltered", "actual_dax_value", [SLA Breaches]),
    ROW("measure", "Average Backlog Hours", "filter_context", "Unfiltered", "actual_dax_value", [Average Backlog Hours]),
    ROW("measure", "High Priority Unresolved", "filter_context", "Unfiltered", "actual_dax_value", [High Priority Unresolved]),
    ROW("measure", "Total Parts", "filter_context", "Unfiltered", "actual_dax_value", [Total Parts]),
    ROW("measure", "Missing Parts", "filter_context", "Unfiltered", "actual_dax_value", [Missing Parts]),
    ROW("measure", "Invalid Parts", "filter_context", "Unfiltered", "actual_dax_value", [Invalid Parts]),
    ROW("measure", "Missing Classification %", "filter_context", "Unfiltered", "actual_dax_value", [Missing Classification %]),
    ROW("measure", "Invalid Classification %", "filter_context", "Unfiltered", "actual_dax_value", [Invalid Classification %]),
    ROW("measure", "Parts Requiring Review", "filter_context", "Unfiltered", "actual_dax_value", [Parts Requiring Review]),
    ROW("measure", "Closed Throughput", "filter_context", "September 2026", "actual_dax_value", CALCULATE([Closed Throughput], DATESBETWEEN(dim_date[date_key], DATE(2026,9,1), DATE(2026,9,30)))),
    ROW("measure", "Previous Month Throughput", "filter_context", "September 2026", "actual_dax_value", CALCULATE([Previous Month Throughput], DATESBETWEEN(dim_date[date_key], DATE(2026,9,1), DATE(2026,9,30)))),
    ROW("measure", "MoM Throughput %", "filter_context", "September 2026", "actual_dax_value", CALCULATE([MoM Throughput %], DATESBETWEEN(dim_date[date_key], DATE(2026,9,1), DATE(2026,9,30)))),
    ROW("measure", "DQ Pass Rate %", "filter_context", "Unfiltered", "actual_dax_value", [DQ Pass Rate %]),
    ROW("measure", "Total Queries", "filter_context", "Priority LOW", "actual_dax_value", CALCULATE([Total Queries], KEEPFILTERS(fact_customs_query[query_priority]="LOW"))),
    ROW("measure", "Open Backlog", "filter_context", "Priority LOW", "actual_dax_value", CALCULATE([Open Backlog], KEEPFILTERS(fact_customs_query[query_priority]="LOW"))),
    ROW("measure", "High Priority Unresolved", "filter_context", "Priority LOW", "actual_dax_value", CALCULATE([High Priority Unresolved], KEEPFILTERS(fact_customs_query[query_priority]="LOW"))),
    ROW("measure", "SLA Compliance %", "filter_context", "Priority LOW", "actual_dax_value", CALCULATE([SLA Compliance %], KEEPFILTERS(fact_customs_query[query_priority]="LOW"))),
    ROW("measure", "Total Queries", "filter_context", "Authority A1", "actual_dax_value", CALCULATE([Total Queries], KEEPFILTERS(dim_authority[authority_id]="A1"))),
    ROW("measure", "Open Backlog", "filter_context", "Authority A1", "actual_dax_value", CALCULATE([Open Backlog], KEEPFILTERS(dim_authority[authority_id]="A1"))),
    ROW("measure", "High Priority Unresolved", "filter_context", "Authority A1", "actual_dax_value", CALCULATE([High Priority Unresolved], KEEPFILTERS(dim_authority[authority_id]="A1"))),
    ROW("measure", "SLA Compliance %", "filter_context", "Authority A1", "actual_dax_value", CALCULATE([SLA Compliance %], KEEPFILTERS(dim_authority[authority_id]="A1"))),
    ROW("measure", "Total Queries", "filter_context", "Empty query cohort", "actual_dax_value", CALCULATE([Total Queries], KEEPFILTERS(dim_date[date_key]=DATE(1900,1,1)))),
    ROW("measure", "Open Backlog", "filter_context", "Empty query cohort", "actual_dax_value", CALCULATE([Open Backlog], KEEPFILTERS(dim_date[date_key]=DATE(1900,1,1)))),
    ROW("measure", "High Priority Unresolved", "filter_context", "Empty query cohort", "actual_dax_value", CALCULATE([High Priority Unresolved], KEEPFILTERS(dim_date[date_key]=DATE(1900,1,1)))),
    ROW("measure", "SLA Compliance %", "filter_context", "Empty query cohort", "actual_dax_value", CALCULATE([SLA Compliance %], KEEPFILTERS(dim_date[date_key]=DATE(1900,1,1)))),
    ROW("measure", "Total Queries", "filter_context", "September opened cohort", "actual_dax_value", CALCULATE([Total Queries], DATESBETWEEN(dim_date[date_key], DATE(2026,9,1), DATE(2026,9,30)))),
    ROW("measure", "Open Backlog", "filter_context", "September opened cohort", "actual_dax_value", CALCULATE([Open Backlog], DATESBETWEEN(dim_date[date_key], DATE(2026,9,1), DATE(2026,9,30)))),
    ROW("measure", "High Priority Unresolved", "filter_context", "September opened cohort", "actual_dax_value", CALCULATE([High Priority Unresolved], DATESBETWEEN(dim_date[date_key], DATE(2026,9,1), DATE(2026,9,30)))),
    ROW("measure", "SLA Compliance %", "filter_context", "September opened cohort", "actual_dax_value", CALCULATE([SLA Compliance %], DATESBETWEEN(dim_date[date_key], DATE(2026,9,1), DATE(2026,9,30))))
)
ORDER BY [filter_context], [measure]
