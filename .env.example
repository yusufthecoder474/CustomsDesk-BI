# Copy only for manual setup; finish_windows.cmd preserves/migrates an existing .env.
CUSTOMSDESK_DATABASE=postgresql
CUSTOMSDESK_HOST=127.0.0.1
CUSTOMSDESK_HOST_PORT=5434
POSTGRES_USER=customsdesk
POSTGRES_DB=customsdesk
POSTGRES_PASSWORD=GENERATE_LOCALLY_DO_NOT_USE_THIS_PLACEHOLDER
# One-click setup generates this ownership marker; no credentials in URLs needed.
CUSTOMSDESK_INSTANCE_ID=
CUSTOMSDESK_CONNECT_TIMEOUT=5
# Optional DATABASE_URL overrides component settings only when host/port/user/db match them.
# Use percent-encoded passwords if supplying a URL. Explicit shell variables override .env.
# DATABASE_URL=postgresql+psycopg://customsdesk:FAKE_ENCODED_PASSWORD@127.0.0.1:5434/customsdesk
# Leave unset until the safe one-click migration rotates the local database role password.
CUSTOMSDESK_PASSWORD_ROTATED=0
